# ===========================================================================
# CodeMart / Pixer Backend — Environment Configuration
# Copy this file to `.env` and edit the values.
# All values below are READ at runtime by docker-compose & the Nest app.
# ===========================================================================

# ---- Application ----
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codemart
DB_USER=codemart
DB_PASSWORD=codemart_strong_password_change_me
# IMPORTANT: keep DB_SYNC=true on first run so tables auto-create from entities.
# Set to false on production once migration system is in place.
DB_SYNC=true
DB_LOGGING=false
DB_POOL_SIZE=10

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_strong_password_change_me
REDIS_DB=0
REDIS_TTL=3600

# ---- JWT / Auth ----
# Generate your own with: openssl rand -hex 32
JWT_ACCESS_SECRET=8f4b2c9a7d3e5f1b6a8c2d4e9f0a3b5c7d8e1f2a4b6c8d0e2f4a6b8c0d2e4f6a
JWT_REFRESH_SECRET=2a4b6c8d0e2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2a4
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PASSWORD_RESET_EXPIRES=3600000
EMAIL_VERIFICATION_EXPIRES=86400000

# ---- Default Super Admin (seeded on first run) ----
SUPER_ADMIN_EMAIL=admin@codemart.io
SUPER_ADMIN_PASSWORD=ChangeMe@Admin123
SUPER_ADMIN_NAME=Super Admin

# ---- File uploads ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# ---- Mailer (Nodemailer) ----
# Defaults to mailtrap (no actual emails will go out). Replace with your SMTP.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=mailtrap_user
MAIL_PASS=mailtrap_pass
MAIL_FROM=no-reply@codemart.io
MAIL_FROM_NAME=CodeMart

# ---- Throttling / Rate-limit ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# ---- Swagger ----
SWAGGER_PATH=docs
