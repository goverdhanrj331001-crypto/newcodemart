# ===========================================================================
# CodeMart / Pixer Backend — Environment Configuration
# Copy this file to `.env` and edit the values.
# All values below are READ at runtime by docker-compose & the Nest app.
# ===========================================================================

# ---- Application ----
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (PostgreSQL) ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=codemart
DB_USER=codemart
DB_PASSWORD=codemart_strong_password_change_me
DB_SYNC=false
DB_LOGGING=false
DB_POOL_SIZE=10

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_strong_password_change_me
REDIS_DB=0
REDIS_TTL=3600

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change_this_access_secret_to_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_this_refresh_secret_to_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
PASSWORD_RESET_EXPIRES=3600000
EMAIL_VERIFICATION_EXPIRES=86400000

# ---- Default Super Admin (seeded on first run) ----
SUPER_ADMIN_EMAIL=admin@codemart.io
SUPER_ADMIN_PASSWORD=ChangeMe@Admin123
SUPER_ADMIN_NAME=Super Admin

# ---- File uploads ----
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=25

# ---- Mailer (Nodemailer) ----
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=mailtrap_user
MAIL_PASS=mailtrap_pass
MAIL_FROM=no-reply@codemart.io
MAIL_FROM_NAME=CodeMart

# ---- Throttling / Rate-limit ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=120
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT=10

# ---- Swagger ----
SWAGGER_PATH=docs
